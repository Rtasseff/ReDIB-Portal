.git
.gitignore
venv/
env/
__pycache__
*.pyc
*.pyo
db.sqlite3
db.sqlite3-journal
.env
.env.*
!.env.example
!.env.production.template
docker-compose*.yml
docs/
tests/
.github/
.claude/
*.md
media/signed_applications/
staticfiles/
