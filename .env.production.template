# ============================================================================
# ReDIB Portal - Production Environment Configuration
# ============================================================================
# Copy this file to .env and fill in all values before starting the stack:
#   cp .env.production.template .env
#
# Generate a secret key with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# ============================================================================

# --- Django Core ---
SECRET_KEY=CHANGE_ME_generate_with_command_above
DEBUG=False
ALLOWED_HOSTS=your-domain.com,www.your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# --- Domain (used by Caddy for automatic TLS) ---
DOMAIN=your-domain.com

# --- Database ---
POSTGRES_DB=redib_db
POSTGRES_USER=redib_user
POSTGRES_PASSWORD=CHANGE_ME_use_a_strong_random_password
DATABASE_URL=postgresql://redib_user:CHANGE_ME_same_password_as_above@db:5432/redib_db
# NOTE: The password in DATABASE_URL must match POSTGRES_PASSWORD exactly.

# --- Redis ---
USE_REDIS=True
REDIS_URL=redis://redis:6379/0

# --- Celery ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- Email (SMTP) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.your-provider.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@your-domain.com
EMAIL_HOST_PASSWORD=CHANGE_ME_your_smtp_password
DEFAULT_FROM_EMAIL=noreply@your-domain.com
CONTACT_EMAIL=info@your-domain.com

# Mass "call announced" / "now open" emails to every opted-in account.
# Leave False. The audience is every account on the portal, and the fan-out
# has no rate limit, no retry, no bounce handling and no unsubscribe link —
# see backlog #41 for the checklist before this goes back on. Announcements
# go out by hand with the /calls/ link in the meantime.
CALL_ANNOUNCEMENT_EMAILS_ENABLED=False


# --- Site URL (used in email links and by Django Sites framework) ---
# SITE_URL: full URL with scheme. SITE_DOMAIN: host:port (no scheme).
SITE_URL=https://portal.redib.net
SITE_DOMAIN=portal.redib.net
SITE_NAME=ReDIB COA Portal

# --- Security ---
# SECURE_SSL_REDIRECT must be False when behind Caddy (Caddy handles HTTPS).
# Setting it to True causes an infinite redirect loop.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# --- Sentry Error Tracking (optional) ---
# Sign up at https://sentry.io and create a Django project to get a DSN.
# Leave empty to disable.
SENTRY_DSN=

# --- Backup Alerting (scripts/backup-db.sh) ---
# ALERT_RECIPIENT: where failure-alert emails go. Sent via the SMTP config
# above, so the From: address is DEFAULT_FROM_EMAIL.
# HEALTHCHECK_URL: deadman-switch URL (e.g., from healthchecks.io). The
# backup script GETs this on successful completion; if the ping never
# arrives, the external service pages you. Leave empty to disable.
# See DEPLOYMENT.md §6.4 for setup instructions.
ALERT_RECIPIENT=coordinator@your-domain.com
HEALTHCHECK_URL=
