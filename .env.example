# ============================================================================
# ReDIB Portal - Local Development Environment Configuration
# ============================================================================
# Copy this file to .env for local development (venv + SQLite + runserver):
#   cp .env.example .env
#
# For production deployment, use .env.production.template instead.
# ============================================================================

# --- Django Core ---
SECRET_KEY=dev-secret-key-change-for-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (SQLite - no setup required) ---
DATABASE_URL=sqlite:///db.sqlite3

# --- Redis (not required for dev; Celery runs in-process when DEBUG=True) ---
USE_REDIS=False
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Email (console backend - prints to terminal) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@redib.net
CONTACT_EMAIL=info@redib.net

# Mass "call announced" / "now open" emails to every opted-in account.
# Leave False. The audience is every account on the portal, and the fan-out
# has no rate limit, no retry, no bounce handling and no unsubscribe link —
# see backlog #41 for the checklist before this goes back on. Announcements
# go out by hand with the /calls/ link in the meantime.
CALL_ANNOUNCEMENT_EMAILS_ENABLED=False


# --- Site URL (used in email links and by Django Sites framework) ---
# Must point to the dev server so emailed links resolve locally.
SITE_URL=http://127.0.0.1:8000
SITE_DOMAIN=127.0.0.1:8000
SITE_NAME=ReDIB COA Portal

# --- Sentry (optional) ---
SENTRY_DSN=

# --- Security (dev values - never use in production) ---
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
